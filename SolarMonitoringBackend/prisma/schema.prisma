generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model plts_current {
  id         Int      @id @default(1)
  timestamp  DateTime @default(now()) @db.Timestamptz(6)
  voltage    Decimal  @default(0) @db.Decimal(6, 2)
  current    Decimal  @default(0) @db.Decimal(6, 2)
  power      Decimal  @default(0) @db.Decimal(8, 2)
  battery    Int      @default(0) @db.SmallInt
  is_normal  Boolean  @default(true)
  source     String   @default("Panel Surya") @db.VarChar(50)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains an index with non-default null sort order and requires additional setup for migrations. Visit https://pris.ly/d/default-index-null-ordering for more info.
model plts_history {
  id         BigInt   @id @default(autoincrement())
  timestamp  DateTime @default(now()) @db.Timestamptz(6)
  voltage    Decimal  @db.Decimal(6, 2)
  current    Decimal  @db.Decimal(6, 2)
  power      Decimal  @db.Decimal(8, 2)
  battery    Int      @db.SmallInt
  is_normal  Boolean  @default(true)
  source     String   @default("Panel Surya") @db.VarChar(50)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([timestamp(sort: Desc)], map: "idx_plts_history_timestamp")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains an index with non-default null sort order and requires additional setup for migrations. Visit https://pris.ly/d/default-index-null-ordering for more info.
model plts_notifications {
  id              BigInt            @id @default(autoincrement())
  timestamp       DateTime          @default(now()) @db.Timestamptz(6)
  type            notification_type
  title           String            @db.VarChar(100)
  message         String
  is_read         Boolean           @default(false)
  read_by_user_id BigInt?
  read_at         DateTime?         @db.Timestamptz(6)
  users           users?            @relation(fields: [read_by_user_id], references: [id])

  @@index([timestamp(sort: Desc)], map: "idx_plts_notifications_timestamp")
  @@index([type], map: "idx_plts_notifications_type")
  @@index([read_by_user_id], map: "idx_notifications_read_by")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model login_logs {
  id             BigInt   @id @default(autoincrement())
  user_id        BigInt
  action         String   @db.VarChar(20)
  ip_address     String?  @db.VarChar(45)
  user_agent     String?
  success        Boolean  @default(true)
  failure_reason String?  @db.VarChar(255)
  timestamp      DateTime @default(now()) @db.Timestamptz(6)
  users          users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([timestamp(sort: Desc)], map: "idx_login_logs_timestamp")
  @@index([user_id], map: "idx_login_logs_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model users {
  id                 BigInt               @id @default(autoincrement())
  username           String               @unique @db.VarChar(50)
  password_hash      String               @db.VarChar(255)
  full_name          String?              @db.VarChar(100)
  is_active          Boolean              @default(true)
  last_login_at      DateTime?            @db.Timestamptz(6)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  login_logs         login_logs[]
  plts_notifications plts_notifications[]

  @@index([username], map: "idx_users_username")
}

enum notification_type {
  normal
  warning
  danger
  info
}
