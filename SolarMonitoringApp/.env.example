# URL backend API (ganti dengan IP/domain VPS BiznetGio saat production)
EXPO_PUBLIC_API_URL=http://<IP_VPS_ATAU_DOMAIN>:5000

# Interval refresh data real-time (milliseconds)
EXPO_PUBLIC_REFRESH_INTERVAL=5000

# Threshold tegangan rendah untuk notifikasi (Volt) - Normal jika >12V
EXPO_PUBLIC_LOW_VOLTAGE_THRESHOLD=12

# Jam tanpa daya sebelum memunculkan warning
EXPO_PUBLIC_NO_POWER_HOURS=24

# Mode Debug (Tampilkan halaman dan elemen UI untuk debugging)
EXPO_PUBLIC_DEBUG=false
